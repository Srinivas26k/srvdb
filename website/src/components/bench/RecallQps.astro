---
// Recall@10 (x) vs single-query QPS (y, log scale), one line per index.
// Inline SVG rendered at build time; no client-side JavaScript.
import { type Run, forThreads, label, isSrvdb, fmt } from './lib';

interface Props { run: Run; threads: number }
const { run, threads } = Astro.props;
const rs = forThreads(run, threads);

const W = 720, H = 400, L = 64, R = 210, T = 16, B = 48;
const pw = W - L - R, ph = H - T - B;
const all = rs.flatMap((r) => r.points!);
const xmin = Math.max(0, Math.floor(Math.min(...all.map((p) => p.recall_at_k)) * 10) / 10);
const qs = all.map((p) => p.qps);
const ymin = Math.pow(10, Math.floor(Math.log10(Math.min(...qs))));
const ymax = Math.pow(10, Math.ceil(Math.log10(Math.max(...qs))));
const x = (v: number) => L + ((v - xmin) / (1 - xmin || 1)) * pw;
const y = (v: number) => T + ph - ((Math.log10(v) - Math.log10(ymin)) / (Math.log10(ymax) - Math.log10(ymin))) * ph;
const xticks = Array.from({ length: Math.round((1 - xmin) * 10) + 1 }, (_, i) => xmin + i / 10);
const yticks: number[] = [];
for (let v = ymin; v <= ymax * 1.001; v *= 10) yticks.push(v);

const dashes = ['', '6 3', '2 3', '8 3 2 3', '1 2', '10 4'];
const others = rs.filter((r) => !isSrvdb(r));
const style = (r: (typeof rs)[number]) => {
	if (isSrvdb(r)) return { stroke: 'var(--sl-color-accent)', dash: dashes[rs.filter(isSrvdb).indexOf(r) % dashes.length], width: 2.5 };
	const i = others.indexOf(r);
	const greys = ['var(--sl-color-gray-2)', 'var(--sl-color-gray-3)', 'var(--sl-color-gray-4)'];
	return { stroke: greys[i % 3], dash: dashes[Math.floor(i / 3) % dashes.length], width: 1.5 };
};
const series = rs.map((r) => {
	const pts = [...r.points!].sort((a, b) => a.recall_at_k - b.recall_at_k);
	return { r, s: style(r), pts, d: pts.map((p, i) => `${i ? 'L' : 'M'}${x(p.recall_at_k).toFixed(1)},${y(p.qps).toFixed(1)}`).join(' ') };
});
const title = `Recall@${run.dataset.k} vs queries per second, ${threads === 1 ? '1 thread' : `${threads} threads`}`;
---
<figure class="bench-fig">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
		<title>{title}</title>
		{xticks.map((t) => (
			<g>
				<line x1={x(t)} x2={x(t)} y1={T} y2={T + ph} class="grid" />
				<text x={x(t)} y={T + ph + 16} text-anchor="middle">{fmt(t, 2)}</text>
			</g>
		))}
		{yticks.map((t) => (
			<g>
				<line x1={L} x2={L + pw} y1={y(t)} y2={y(t)} class="grid" />
				<text x={L - 6} y={y(t) + 4} text-anchor="end">{fmt(t)}</text>
			</g>
		))}
		<text x={L + pw / 2} y={H - 8} text-anchor="middle">recall@{run.dataset.k} (higher is better)</text>
		<text x={14} y={T + ph / 2} text-anchor="middle" transform={`rotate(-90 14 ${T + ph / 2})`}>QPS, log scale (higher is better)</text>
		{series.map(({ s, pts, d }) => (
			<g>
				<path d={d} fill="none" stroke={s.stroke} stroke-width={s.width} stroke-dasharray={s.dash} />
				{pts.map((p) => <circle cx={x(p.recall_at_k)} cy={y(p.qps)} r="3" fill={s.stroke} />)}
			</g>
		))}
		{series.map(({ r, s }, i) => (
			<g transform={`translate(${L + pw + 14}, ${T + 8 + i * 18})`}>
				<line x1="0" x2="24" y1="0" y2="0" stroke={s.stroke} stroke-width={s.width} stroke-dasharray={s.dash} />
				<text x="30" y="4" class={isSrvdb(r) ? 'srv' : ''}>{label(r)}</text>
			</g>
		))}
	</svg>
	<figcaption>{title}. {run.dataset.name}, {run.dataset.queries} queries. Points along a line are ef_search or nprobe settings; single points are indexes without a search-time knob.</figcaption>
</figure>

<style>
	.bench-fig { margin: var(--srv-space-4) 0; }
	svg { width: 100%; height: auto; font-size: 11px; }
	svg text { fill: var(--sl-color-gray-2); }
	svg text.srv { fill: var(--sl-color-accent); font-weight: 600; }
	.grid { stroke: var(--sl-color-gray-5); stroke-width: 1; }
	figcaption { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>
