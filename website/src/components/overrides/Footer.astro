---
// Default Starlight footer (edit link, last updated, pagination) followed by
// a feedback prompt and community links on every page.
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const discussions = 'https://github.com/Srinivas26k/srvdb/discussions/categories/community-feedback';
---

<Default {...Astro.props}><slot /></Default>
<div class="srv-feedback print:hidden">
	<p>
		Was this page helpful?{' '}<a href={discussions}>Tell us in Discussions</a>.
	</p>
	<p class="srv-feedback-links">
		<a href={`${base}/project/community/`}>Community</a>
		<span aria-hidden="true">·</span>
		<a href={`${base}/project/contributing/`}>Contribute</a>
		<span aria-hidden="true">·</span>
		<a href={`${base}/project/sponsor/`}>Sponsor</a>
	</p>
</div>

<style>
	.srv-feedback {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.srv-feedback p {
		margin: 0.25rem 0;
	}
	.srv-feedback a {
		color: var(--sl-color-white);
	}
	.srv-feedback-links {
		display: flex;
		gap: 0.5rem;
	}
</style>
