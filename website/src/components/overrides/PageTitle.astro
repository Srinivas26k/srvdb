---
// Page header: the sidebar group the page belongs to as a small eyebrow,
// the title, then the frontmatter description as a muted subtitle.
// Starlight's PAGE_TITLE_ID, which the package does not export.
const PAGE_TITLE_ID = '_top';

const { entry, sidebar } = Astro.locals.starlightRoute;

type Entry = { type: string; label: string; isCurrent?: boolean; entries?: Entry[] };
const contains = (e: Entry): boolean =>
	e.type === 'link' ? Boolean(e.isCurrent) : (e.entries ?? []).some(contains);
const group = (sidebar as Entry[]).find((e) => e.type === 'group' && contains(e));
const eyebrow = group?.label;
// Skip the subtitle when the page body already opens with the same
// sentence (the API reference pages do), so it is not shown twice.
const norm = (t: string) => t.replace(/\s+/g, ' ').trim();
const firstParagraph = (entry.body ?? '')
	.split(/\n\s*\n/)
	.map(norm)
	.find((p) => p !== '' && !p.startsWith('import '));
const description =
	entry.data.description && firstParagraph !== norm(entry.data.description)
		? entry.data.description
		: undefined;
---

{eyebrow && <p class="srv-eyebrow">{eyebrow}</p>}
<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
{description && <p class="srv-subtitle">{description}</p>}

<style>
	.srv-eyebrow {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-3);
	}
	h1 {
		margin-top: 0.375rem;
		font-size: 2.25rem;
		line-height: 1.2;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.srv-subtitle {
		margin-top: 0.75rem;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
</style>
