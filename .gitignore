# Files generated by builds, tests and tools. Nothing here may be committed
# (AGENTS.md section 14). Website-specific rules live in website/.gitignore.

# --- Rust -------------------------------------------------------------------
/target
**/*.rs.bk
# Per-developer Cargo settings (e.g. a custom target-dir)
/.cargo/

# --- Python -----------------------------------------------------------------
# Compiled extension built by `maturin develop`
python/srvdb/*.so
python/srvdb/*.pyd
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
/wheels/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Website (website/) -------------------------------------------------------
node_modules/
website/dist/
website/.astro/

# --- Databases created by tests, examples and benchmarks ---------------------
*test_docs
svdb/bench_release_db
/demo_db/
/rust-db/
/quickstart-db/
/my-db/
/rag-db/

# --- Brand kit build font (download, do not commit) ---------------------------
assets/brand/tools/font/

# --- Mutation testing ----------------------------------------------------------
mutants.out*/

# --- Editors and operating systems ---------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# --- Secrets ------------------------------------------------------------------
.env
.env.*
